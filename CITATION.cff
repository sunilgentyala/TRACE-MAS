    orcid: "https://orcid.org/0000-0000-0000-0000"
repository-code: "https://github.com/sunilgentyala/TRACE-MAS"
url: "https://sunilgentyala.github.io/TRACE-MAS/"
license: MIT
date-released: "2026-06-11"
keywords:
  - multi-agent systems
  - LLM security
  - zero-knowledge proofs
  - prompt injection
  - alignment drift
  - temporal adversarial attacks
  - agentic AI
  - cryptographic frameworks
